d=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="1300" y="850" width="78" height="78" as="geometry"/></mxCell><mxCell id="1 - Production infrastructure-29" value='&lt;b&gt;CodeDeploy&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;blue/green · canary&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;$0&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codedeploy;" vertex="1" parent="1"><mxGeometry x="1520" y="850" width="78" height="78" as="geometry"/></mxCell><mxCell id="1 - Production infrastructure-30" value="image pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.0952;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 - Production infrastructure-8" target="1 - Production infrastructure-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 - Production infrastructure-31" value="logs + metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3067;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 - Production infrastructure-8" target="1 - Production infrastructure-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 - Production infrastructure-32" value="alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontColor=#C62828;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 - Production infrastructure-27" target="1 - Production infrastructure-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 - Production infrastructure-33" value="swaps ALB target groups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C925D1;fontColor=#C925D1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.73;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 - Production infrastructure-29" target="1 - Production infrastructure-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 - Production infrastructure-34" value="&lt;b&gt;Network and access&lt;/b&gt;&lt;br&gt;• ALB SG: :80 only from the CloudFront origin-facing prefix list&lt;br&gt;• Task SG: :3000 only from the ALB SG; egress :443 to the endpoints and the S3 prefix list&lt;br&gt;• Endpoint SG: :443 from the VPC CIDR · no public IPs · the internet gateway exists only because VPC origins need it, no route points at it&lt;br&gt;&lt;br&gt;&lt;b&gt;IAM&lt;/b&gt;&lt;br&gt;• Execution role: pull from ECR, write logs. No task role: the API is stateless and calls no AWS service&lt;br&gt;• Deploys use a GitHub OIDC role scoped to one environment (page 2)&lt;br&gt;&lt;br&gt;&lt;b&gt;Alarms (SNS email)&lt;/b&gt;&lt;br&gt;• API 5xx &amp;gt; 5 / min for 3 min · p95 latency &amp;gt; 1.5 s (both also roll back releases)&lt;br&gt;• No running tasks · CPU &amp;gt; 85 % · CloudFront 5xx rate &amp;gt; 5 %" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="200" y="650" width="590" height="250" as="geometry"/></mxCell><mxCell id="1 - Production infrastructure-35" value='&lt;b&gt;dev: ~$54 / month&lt;/b&gt; (not deployed)&lt;br&gt;&lt;span style="font-size:11px;"&gt;Fargate 1 x 0.25 vCPU / 0.5 GB $7 · ALB $18 · 3 interface endpoints x 1 AZ $22&lt;br&gt;CloudFront $1 · Route 53 $1 · CloudWatch $4 · ECR + S3 $0.5&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="900" height="100" as="geometry"/></mxCell><mxCell id="1 - Production infrastructure-36" value='&lt;b&gt;prod: ~$104 / month&lt;/b&gt; (not deployed)&lt;br&gt;&lt;span style="font-size:11px;"&gt;Fargate 2 x 0.5 vCPU / 1 GB $29 · ALB $20 · 3 interface endpoints x 2 AZ $44&lt;br&gt;CloudFront $3 · Route 53 $1 · CloudWatch $7 · ECR + S3 $0.5&lt;br&gt;Autoscaling to 6 tasks adds ~$14 per task-month&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="960" y="1040" width="900" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2 - CI/CD and blue-green" name="2 - CI/CD and blue-green"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 - CI/CD and blue-green-1" value='&lt;b style="font-size:20px;"&gt;Delivery: GitHub Actions to CodeDeploy blue/green&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;OIDC federation (no stored keys) · ECR · task definition revision · CodeDeploy · S3 sync · CloudFront invalidation&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#F6F8FA;strokeColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="500" height="930" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-3" value="&lt;b&gt;GitHub: andresazcona/sqlhelper-platform&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="460" height="24" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-4" value='&lt;b&gt;ci.yml&lt;/b&gt; · pull_request and push to main&lt;br&gt;&lt;span style="font-size:11px;"&gt;terraform fmt -check · validate (4 roots) · tflint · checkov&lt;br&gt;needs no AWS credentials&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="460" height="90" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-5" value="&lt;b&gt;1&lt;/b&gt;  deploy.yml · workflow_dispatch (environment, app_ref)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="460" height="50" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-6" value='&lt;b&gt;2&lt;/b&gt;  preflight job, inside the GitHub Environment&lt;br&gt;&lt;span style="font-size:11px;"&gt;no-op unless vars.AWS_ROLE_ARN is set&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="460" height="70" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-7" value='&lt;b&gt;3&lt;/b&gt;  api job (arm64 runner)&