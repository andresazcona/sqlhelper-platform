lAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="623" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-49" value='&lt;span style="font-size:11px;color:#fff;"&gt;&lt;b&gt;90 %&lt;/b&gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#1A73E8;strokeColor=#1A73E8;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="623" width="117" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-50" value='&lt;span style="font-size:11px;"&gt;Green (v2) · 10 %&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="655" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-51" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="675" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-52" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#2E7D32;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="675" width="13" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-53" value='&lt;span style="font-size:11px;"&gt;alarms watched; healthy goes on&lt;/span&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="711" width="140" height="50" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-54" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1520" y="555" width="160" height="210" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-55" value="&lt;b&gt;T2 · switched&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="563" width="140" height="36" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-56" value='&lt;span style="font-size:11px;"&gt;Blue (v1)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1535" y="603" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-57" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1535" y="623" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-58" value='&lt;span style="font-size:11px;"&gt;Green (v2)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1535" y="655" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-59" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1535" y="675" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-60" value='&lt;span style="font-size:11px;color:#fff;"&gt;&lt;b&gt;100 %&lt;/b&gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#2E7D32;strokeColor=#2E7D32;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1535" y="675" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-61" value='&lt;span style="font-size:11px;"&gt;blue kept 5 min, then terminated&lt;/span&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="711" width="140" height="50" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-62" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#C62828;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="555" width="160" height="210" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-63" value="&lt;b&gt;Alarm fires&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="563" width="140" height="36" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-64" value='&lt;span style="font-size:11px;"&gt;Blue (v1)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1715" y="603" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-65" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1715" y="623" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-66" value='&lt;span style="font-size:11px;color:#fff;"&gt;&lt;b&gt;100 %&lt;/b&gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#1A73E8;strokeColor=#1A73E8;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1715" y="623" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-67" value='&lt;span style="font-size:11px;"&gt;Green (v2)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1715" y="655" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-68" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1715" y="675" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-69" value='&lt;span style="font-size:11px;"&gt;stop, route back to blue, stop green&lt;/span&gt;' style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="711" width="140" height="50" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-70" value="&lt;b&gt;Release rules&lt;/b&gt;&lt;br&gt;• dev uses ECSAllAtOnce (no canary); staging and prod use the canary above&lt;br&gt;• Rollback gates: &amp;lt;env&amp;gt;-api-5xx and &amp;lt;env&amp;gt;-api-latency-p95, plus deployment failure&lt;br&gt;• The ECS service uses the CODE_DEPLOY controller; Terraform ignores task definition, target group and desired count after the first apply&lt;br&gt;• Frontend goes live only after the API job succeeds; old hashed assets are never deleted, so open tabs keep working" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="790" width="700" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3 - Environments and state" name="3 - Environments and state"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 - Environments and state-1" value='&lt;b style="font-size:20px;"&gt;Environments and Terraform state layout&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;one AWS account per environment · one S3 state bucket per account · native S3 locking (use_lockfile) · shared local modules&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="3 - Environments and state-2" value="&lt;span style=&quot;font-family:monospace;font-size:11px;&quot;&gt;sqlhelper-platform/&lt;br&gt;|--&amp;nbsp;bootstrap/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;state bucket, local state&lt;/span&gt;&lt;br&gt;|--&amp;nbsp;modules/&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;network/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;VPC, subnets, endpoints&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;ecr/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;repository, lifecycle&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;api/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;ALB, Fargate, CodeDeploy&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;edge/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;S3, CloudFront, ACM, DNS&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;monitoring/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;alarms, SNS, dashboard&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;`--&amp;nbsp;github-oidc/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;OIDC provider + role&lt;/span&gt;&lt;br&gt;|--&amp;nbsp;envs/&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;dev/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;own backend key&lt;/span&gt;&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;|--&amp;nbsp;staging/&lt;br&gt;|&amp;nbsp;&amp;nbsp;&amp;nbsp;`--&amp;nbsp;prod/&lt;br&gt;|--&amp;nbsp;deploy/appspec.yaml&lt;br&gt;`--&amp;nbsp;.github/workflows/&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color:#888;'&gt;ci.yml · deploy.yml&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="290" as="geometry"/></mxCell><mxCell id="3 - Environments and state-3" value="&lt;b&gt;State layout&lt;/b&gt;&lt;br&gt;• bootstrap/ runs once per account with local state and creates &lt;span style='font-family:monospace;'&gt;sqlhelper-tfstate-&amp;lt;account&amp;gt;&lt;/span&gt;: versioned, encrypted, public access blocked, TLS-only policy, old versions kept 90 days&lt;br&gt;• Each envs/* root then points its s3 backend at that bucket with its own key and &lt;span style='font-family:monospace;'&gt;use_lockfile = true&lt;/span&gt;: Terraform 1.10+ locks with a conditional write of a .tflock object, so there is no DynamoDB table to create, pay for or keep in sync&lt;br&gt;• Blast radius: a bad apply in dev cannot touch prod state, resources or IAM; the account boundary is the isolation&lt;br&gt;• allowed_account_ids in every provider block stops an env being applied to the wrong account&lt;br&gt;• Account ids shown are placeholders" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="520" height="260" as="geometry"/></mxCell><mxCell id="3 - Environments and state-4" value='&lt;b&gt;modules/&lt;/b&gt; · network · ecr · api · edge · monitoring · github-oidc&lt;br&gt;&lt;span style="font-size:11px;"&gt;identical code in every environment; only the inputs (sizes, counts, CIDR, deploy config, retention) differ&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="1260" height="70" as="geometry"/></mxCell><mxCell id="3 - Environments and state-5" value="Account 111111111111: dev" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1"><mxGeometry x="600" y="230" width="400" height="430" as="geometry"/></mxCell><mxCell id="3 - Environments and state-6" value='&lt;b&gt;envs/dev&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;VPC 10.10.0.0/16 · endpoints in 1 AZ&lt;br&gt;API: 1 task · 0.25 vCPU / 0.5 GB · no autoscaling&lt;br&gt;Releases: ECSAllAtOnce, no canary&lt;br&gt;Logs 14 days · ALB deletion protection off&lt;br&gt;Stack: network · ecr · api · edge · monitoring · github-oidc&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="280" width="360" height="150" as="geometry"/></mxCell><mxCell id="3 - Environments and state-7" value='&lt;b&gt;S3 state bucket&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#666;"&gt;sqlhelper-tfstate-111111111111&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#2E7D32;"&gt;key dev/terraform.tfstate&lt;/span&gt;' style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="761" y="470" width="78" height="78" as="geometry"/></mxCell><mxCell id="3 - Environments and state-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontColor=#8C4FFF;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.2787301587301588;exitY=1;exitDx=0;exitDy=0;entryX=0.92;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 - Environments and state-4" target="3 - Environments and state-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 - Environments and state-9" value="init · plan · apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888888;fontColor=#888888;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 - Environments and state-6" target="3 - Environments and state-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 - Environments and state-10" value='&lt;b&gt;GitHub environment: dev&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;vars: AWS_ROLE_ARN · FRONTEND_BUCKET · CLOUDFRONT_DISTRIBUTION_ID&lt;br&gt;copied from the stack output github_environment_variables; protection rules (reviewers) live here&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F6F8FA;strokeColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="710" width="400" height="100" as="geometry"/></mxCell><mxCell id="3 - Environments and state-11" value="OIDC deploy role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 - Environments and state-10" target="3 - Environments and state-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 - Environments and state-12" value='&lt;b&gt;dev: ~$54 / month&lt;/b&gt; (not deployed)&lt;br&gt;&lt;span style="font-size:11px;"&gt;Fargate 1 x 0.25 vCPU / 0.5 GB $7 · ALB $18 · 3 interface endpoints x 1 AZ $22&lt;br&gt;CloudFront $1 · Route 53 $1 · CloudWatch $4 · ECR + S3 $0.5&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="850" width="400" height="100" as="geometry"/></mxCell><mxCell id="3 - Environments and state-13" value="Account 222222222222: staging" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontCo