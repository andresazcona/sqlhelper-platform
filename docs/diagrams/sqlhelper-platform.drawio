ntryDx=0;entryDy=0;" edge="1" parent="1" source="2 - CI/CD and blue-green-33" target="2 - CI/CD and blue-green-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="439"/><mxPoint x="1060" y="665"/></Array></mxGeometry></mxCell><mxCell id="2 - CI/CD and blue-green-36" value="&lt;b&gt;Traffic during a prod release&lt;/b&gt; (CodeDeployDefault.ECSCanary10Percent5Minutes)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="690" height="24" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-37" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#1A73E8;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="555" width="160" height="210" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-38" value="&lt;b&gt;T0 · steady state&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="563" width="140" height="36" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-39" value='&lt;span style="font-size:11px;"&gt;Blue (v1)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1175" y="603" width="130" height="18" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-40" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#eeeeee;strokeColor=#cccccc;fontSize=12;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1175" y="623" width="130" height="22" as="geometry"/></mxCell><mxCell id="2 - CI/CD and blue-green-41" value='&lt;span style="font-size:11px;color:#fff;"&gt;&lt;b&gt;100 %&lt;/b&gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;fillColor=#1A73E8;strokeColor=#1A73E8;fontSize=12;align=center;verticalAlign=middle;spacing=10